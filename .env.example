PORT=3002
ADMIN_KEY=admin123
SQLITE_FILE=
# DATABASE_URL=postgres://user:password@localhost:5432/tokensurvey

# Real email (OTP). Leave blank to run in demo mode (code shown on screen).
# Preferred on hosts that block SMTP ports (e.g. Render): use an HTTP email API.
# Brevo: EMAIL_PROVIDER=brevo, BREVO_API_KEY FROM Brevo > SMTP & API > API Keys
EMAIL_PROVIDER=
BREVO_API_KEY=
# SENDGRID_API_KEY=
# RESEND_API_KEY=
EMAIL_FROM=University Participation System <no-reply@yourdomain.com>
APP_NAME=University Participation System

# SMTP (only works where outbound ports 25/465/587 are allowed, e.g. a VPS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
